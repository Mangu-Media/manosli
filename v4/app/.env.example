# MongoDB connection string (Atlas or self-hosted). Required by api/.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Optional database name override (defaults to "manosli").
# MONGODB_DB=manosli

# Secret used to sign session JWTs (HS256). Use a long random string in prod.
JWT_SECRET=change-me-to-a-long-random-string

# OAuth provider app ids — /api/auth/oauth returns 501 "not_configured"
# until these are set AND token verification is implemented (see api/auth/oauth.ts).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
