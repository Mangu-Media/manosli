{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --package-lock=false --legacy-peer-deps --registry=https://registry.npmjs.org",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  }
}
